{% extends 'container_layout.html.twig' %}

{% set communityTestCourseSubject = exam.testYear.communityTestCourseSubject %}
{% set communityTest = communityTestCourseSubject.communityTest %}
{% set courseSubject = communityTestCourseSubject.courseSubject %}
{% set pauBundlePack = getPauBundlePackForExam(exam) %}
{% set showPauBundlePackPromo = pauBundlePack is not null %}
{% set isMadridMath2025Modelo = communityTest.knowledgeTest.slug == 'selectividad'
    and communityTest.community.slug == 'madrid'
    and courseSubject.subjectSlug == 'matematicas'
    and exam.slug == '2025-modelo'
%}

{% if isMadridMath2025Modelo %}
  {% set metaTitle = 'PAU Madrid 2025 Modelo Matemáticas II | Enunciado y solución' %}
  {% set title = 'PAU Madrid 2025 Modelo Matemáticas II: enunciado, temas y solución' %}
  {% set metaDescription = 'Consulta el modelo PAU/EvAU Madrid 2025 de Matemáticas II: enunciado, datos del examen, bloques, preguntas, temas, dificultad y acceso a la solución.' %}
{% else %}
  {% set metaTitle =  communityTest.knowledgeTest.name ~ ' de ' ~ communityTest.community.name ~ ': ' ~
      courseSubject.subjectName ~ ' ' ~ exam.name %}
  {% set title =  communityTest.knowledgeTest.name|lower ~ ' de ' ~ communityTest.community.name ~ ': ' ~
      courseSubject.subjectName ~ ' ' ~ exam.name %}
  {% set metaDescription = "Descarga el examen de " ~ communityTest.knowledgeTest.name ~ " resuelto de " ~ courseSubject.subjectName ~ ". Año: " ~ exam.name  %}
{% endif %}

{% block metatags %}
<title>{{ metaTitle }}</title>
<meta name="description" content="{{ metaDescription }}" />
<meta property="og:title" content="{{ metaTitle }}" />
<meta property="og:description" content="{{ metaDescription }}" />
{% if isMadridMath2025Modelo %}
<link rel="canonical" href="{{ getCanonicalUrl() }}">
{% endif %}
{% endblock %}

{% block pageTitle %}
  Examen de {{ title }}
{% endblock %}

{% block breadcrumb %}
{{ renderBreadcrumb(exam) }}
{% endblock %}

{% block pageContent %}
{% if isMadridMath2025Modelo %}
  {% include 'views/knowledge_tests/exam/seo/madrid_matematicas_2025_modelo.html.twig' %}
{% else %}
<section>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="col-span-12 lg:col-span-8">
      <h2 class="h2 mb-4">Ver archivos de este examen</h2>
      <div class="mb-4 list-group">
        {% for file in exam.files %}
          {% if canSeeExamFile(file) %}
            <a href="{{ path('file', {'fileId': file.id}) }}" 
              class="list-group-item"
              title="{{ file.name }}"
              onclick="gtag('event', 'click', {
                'event_category': 'view-file',
                'event_label': 'exam'
              });"
            >
              <span>Ver {{ file.name }}</span>
              <span class="list-group-item-badge"><i class="icon-angle-right"></i></span>
            </a>
          {% elseif showPauBundlePackPromo %}
          <a href="{{ path('product_show', {slug: pauBundlePack.slug}) }}"
            class="list-group-item"
            onclick="gtag('event', 'click', {
              'event_category': 'product-pack',
              'event_label': 'locked-exam-file'
            });"
          >
            <span>Ver {{ file.name }} en el pack PAU {{ pauBundlePack.subjectName }} {{ pauBundlePack.communityName }}</span>
            <span class="list-group-item-badge">{{ pauBundlePack.formattedPrice }} <i class="icon-angle-right"></i></span>
          </a>
          {% else %}
          <a href="{{path('app_register')}}" 
            class="list-group-item"
            rel="nofollow"
            onclick="gtag('event', 'click', {
              'event_category': 'premium-box',
              'event_label': 'chapter'
            });"
          >
            <span>Ver {{ file.name }} (hazte premium para poder verlo)</span>
            <span class="list-group-item-badge"><i class="icon-angle-right"></i></span>
          </a>
          {% endif %}
        {% endfor %}
      </div>
      <h2 class="h2 mb-4">Contenidos</h2>
      <div class="text-lg">{{ exam.description|raw }}</div>
    </div>
    <aside class="col-span-12 lg:col-span-4" role="complementary">
      <div class="simple-box mb-8 font-bold text-2xl">
        Dificultad: {{ exam.difficulty }}
      </div>
      {% if showPauBundlePackPromo %}
        {% include 'common/products/pau_bundle_pack_promo.html.twig' with {
          pack: pauBundlePack,
          compact: true,
          event_label: 'exam-sidebar'
        } %}
      {% endif %}
      {% if not app.user and not canSeeExam(exam) and not showPauBundlePackPromo %}
      <div class="simple-box mb-8">
        <h4 class="h4 mb-4">¿Quieres acceder a más contenido aún?</h3>
        <p class="mb-4">Con Clases de Apoyo Premium podrás acceder a los exámenes de selectividad resueltos de todos los años, a las soluciones
        de los ejercicios que te proponemos en cada tema, preguntarle a tu profe IA sobre cualquier documento y todo ello sin ver un anuncio más.</p>
        <a 
          class="btn btn-secondary block text-center"
          href="{{path('app_register')}}"
          rel="nofollow"
          onclick="gtag('event', 'click', {
            'event_category': 'premium-box',
            'event_label': 'exam'
          });"
        >
          Quiero hacerme premium
        </a>
      </div>
      {% endif %}
      {% include 'ads/sidebar_ad.html.twig' with { 'mb': 'mb-8'} %}
      {% include 'common/elements/youtube_box.html.twig' %}
    </aside>
  </div>
</section>
{% endif %}
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
{% endblock stylesheets %}


{% block javascripts %}
{% if isMadridMath2025Modelo %}
<script type="application/ld+json">
{{ {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': getCanonicalUrl() ~ '#breadcrumb',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: url('home')
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Exámenes de selectividad',
          item: url('knowledge_test', {testSlug: communityTest.knowledgeTest.slug})
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Madrid',
          item: url('community_test', {testSlug: communityTest.knowledgeTest.slug, communitySlug: communityTest.community.slug})
        },
        {
          '@type': 'ListItem',
          position: 4,
          name: 'Matemáticas II',
          item: url('community_test_course_subject', {
            testSlug: communityTest.knowledgeTest.slug,
            communitySlug: communityTest.community.slug,
            courseSubjectSlug: courseSubject.subjectSlug
          })
        },
        {
          '@type': 'ListItem',
          position: 5,
          name: 'Modelo 2025',
          item: getCanonicalUrl()
        }
      ]
    },
    {
      '@type': ['Article', 'LearningResource'],
      '@id': getCanonicalUrl() ~ '#exam',
      headline: metaTitle,
      name: title,
      description: metaDescription,
      url: getCanonicalUrl(),
      inLanguage: 'es',
      datePublished: exam.createdAt|date('Y-m-d'),
      dateModified: exam.updatedAt|date('Y-m-d'),
      educationalLevel: '2º Bachillerato',
      learningResourceType: ['Examen PAU', 'Modelo de examen', 'Solución de examen'],
      about: [
        'PAU Madrid',
        'EvAU Madrid',
        'Matemáticas II',
        'Matrices y sistemas de ecuaciones',
        'Continuidad e integrales',
        'Geometría analítica en el espacio',
        'Probabilidad binomial y aproximación normal'
      ],
      author: {
        '@type': 'Person',
        name: 'Juan Carlos Rojo',
        jobTitle: 'Profesor de apoyo especializado en PAU, Bachillerato y ESO'
      },
      publisher: {
        '@type': 'Organization',
        '@id': app.request.getSchemeAndHttpHost() ~ '#organization',
        name: 'Clases de Apoyo',
        url: app.request.getSchemeAndHttpHost(),
        logo: app.request.getSchemeAndHttpHost() ~ asset('build/images/logo.png'),
        sameAs: [
          'https://www.instagram.com/clases_de_apoyo/',
          'https://www.youtube.com/channel/UC_7mMMKSQSrXrNmpVScQPJQ',
          'https://twitter.com/clasesdeapoyo',
          'https://www.facebook.com/clasesdeapoyo/'
        ]
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': getCanonicalUrl()
      }
    }
  ]
}|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }}
</script>
{% else %}
<script type="application/ld+json">
{ "@context": "http://schema.org", 
 "@type": "ScholarlyArticle",
 "headline": "{{ metaTitle }}",
 "author": "Clases de Apoyo", 
 "editor": "Juan Carlos Rojo", 
 "keywords": "pau selectividad bachillerato {{ courseSubject.subjectName }}",
 "url": "{{ getCanonicalUrl() }}",
 "datePublished": "{{ exam.createdAt|date('Y-m-d') }}",
 "dateCreated": "{{ exam.createdAt|date('Y-m-d') }}",
 "dateModified": "{{ exam.updatedAt|date('Y-m-d') }}",
 "description": "{{ metaDescription }}"
 }
</script>
{% endif %}
{% endblock javascripts %}
