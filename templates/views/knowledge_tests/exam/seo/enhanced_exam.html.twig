{% macro fillPlaceholders(text, exam, pauBundlePack) %}
  {{ text
    |replace({
      '{difficulty}': exam.difficulty,
      '{fileName}': '',
      '{subjectName}': pauBundlePack ? pauBundlePack.subjectName : '',
      '{communityName}': pauBundlePack ? pauBundlePack.communityName : '',
      '{yearRange}': pauBundlePack ? pauBundlePack.yearRange : '',
      '{formattedPrice}': pauBundlePack ? pauBundlePack.formattedPrice : ''
    })
  }}
{% endmacro %}

{% import _self as enhancedExam %}

<section>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <article class="col-span-12 lg:col-span-8">
      <div class="simple-box mb-8">
        <h2 class="h2 mb-4">{{ enhancedExamPage.summaryTitle|default('Resumen del examen') }}</h2>
        {% for paragraph in enhancedExamPage.summaryParagraphs %}
          <p class="text-lg{% if not loop.last %} mb-4{% endif %}">
            {{ paragraph }}
          </p>
        {% endfor %}
      </div>

      {% if showPauBundlePackPromo and enhancedExamPage.solutionCta is defined %}
        <div class="simple-box mb-8 border border-green-200 bg-green-50">
          <p class="mb-2 text-sm font-bold uppercase text-green-700">{{ enhancedExamPage.solutionCta.eyebrow }}</p>
          <h2 class="h2 mb-4">{{ enhancedExamPage.solutionCta.title }}</h2>
          <p class="text-lg mb-4">
            {{ enhancedExam.fillPlaceholders(enhancedExamPage.solutionCta.text, exam, pauBundlePack) }}
          </p>
          <p class="mb-4 text-sm font-bold text-green-800">{{ enhancedExam.fillPlaceholders(enhancedExamPage.solutionCta.priceText, exam, pauBundlePack) }}</p>
          <a
            class="btn btn-secondary inline-block text-center"
            href="{{ path('product_show', {slug: pauBundlePack.slug}) }}"
            onclick="gtag('event', 'click', {
              'event_category': 'product-pack',
              'event_label': '{{ enhancedExamPage.solutionCta.eventLabel }}'
            });"
          >
            {{ enhancedExamPage.solutionCta.buttonLabel }}
          </a>
        </div>
      {% endif %}

      <h2 class="h2 mb-4">{{ enhancedExamPage.statementTitle }}</h2>
      <div class="mb-8 list-group">
        {% for file in exam.files %}
          {% set normalizedFileName = file.name|default('')|lower|trim %}
          {% set isStatementFile = normalizedFileName starts with 'enunciado' %}
          {% set isSolutionFile = normalizedFileName starts with 'solucion' or normalizedFileName starts with 'solución' %}
          {% if canSeeExamFile(file) %}
            <a href="{{ path('file', {'fileId': file.id}) }}"
              class="list-group-item"
              title="{{ isStatementFile ? enhancedExamPage.visibleFileTitle|default(file.name) : file.name }}"
              onclick="gtag('event', 'click', {
                'event_category': 'view-file',
                'event_label': '{{ enhancedExamPage.analyticsLabel }}'
              });"
            >
              <span>{{ isStatementFile ? enhancedExamPage.visibleFileLabel : 'Ver ' ~ file.name }}</span>
              <span class="list-group-item-badge"><i class="icon-angle-right"></i></span>
            </a>
          {% elseif showPauBundlePackPromo %}
            <a href="{{ path('product_show', {slug: pauBundlePack.slug}) }}"
              class="list-group-item"
              onclick="gtag('event', 'click', {
                'event_category': 'product-pack',
                'event_label': '{{ enhancedExamPage.analyticsLabel }}'
              });"
            >
              <span>
                {% if isSolutionFile %}
                  {{ enhancedExam.fillPlaceholders(enhancedExamPage.lockedFileLabel, exam, pauBundlePack) }}
                {% else %}
                  Ver {{ file.name }} en el pack PAU {{ pauBundlePack.subjectName }} {{ pauBundlePack.communityName }}
                {% endif %}
              </span>
              <span class="list-group-item-badge">{{ pauBundlePack.formattedPrice }} <i class="icon-angle-right"></i></span>
            </a>
          {% else %}
            <a href="{{ path('app_register') }}"
              class="list-group-item"
              rel="nofollow"
              onclick="gtag('event', 'click', {
                'event_category': 'premium-box',
                'event_label': '{{ enhancedExamPage.analyticsLabel }}'
              });"
            >
              <span>{{ enhancedExamPage.premiumFileLabel|replace({'{fileName}': file.name}) }}</span>
              <span class="list-group-item-badge"><i class="icon-angle-right"></i></span>
            </a>
          {% endif %}
        {% endfor %}
      </div>

      <h2 class="h2 mb-4">{{ enhancedExamPage.examDataTitle|default('Datos del examen') }}</h2>
      <div class="mb-8">
        <dl class="md:hidden divide-y divide-slate-200 border-y border-slate-200">
          {% for row in enhancedExamPage.examData %}
            <div class="py-3">
              <dt class="mb-1 text-sm font-bold text-slate-700">{{ row.label }}</dt>
              <dd class="text-body break-words">{{ enhancedExam.fillPlaceholders(row.value, exam, pauBundlePack) }}</dd>
            </div>
          {% endfor %}
        </dl>
        <table class="hidden md:table border-collapse table-auto w-full">
          <tbody>
            {% for row in enhancedExamPage.examData %}
              <tr{% if loop.index is even %} class="bg-gray-50"{% endif %}>
                <th class="border-b p-4 text-slate-700 text-left font-bold text-lg">{{ row.label }}</th>
                <td class="border-b p-4 text-body">{{ enhancedExam.fillPlaceholders(row.value, exam, pauBundlePack) }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <h2 class="h2 mb-4">{{ enhancedExamPage.questionsTitle }}</h2>
      <div class="mb-8">
        <div class="md:hidden divide-y divide-slate-200 border-y border-slate-200">
          {% for question in enhancedExamPage.questions %}
            <section class="py-4">
              <div class="mb-2 flex flex-wrap items-center gap-2">
                <span class="text-sm font-bold text-slate-700">{{ question.block }}</span>
                <span class="text-sm text-slate-500">{{ question.question }}</span>
              </div>
              <p class="mb-2 text-body break-words">{{ question.task }}</p>
              <p class="text-sm font-bold text-slate-700 break-words">{{ question.topic }}</p>
            </section>
          {% endfor %}
        </div>
        <table class="hidden md:table border-collapse table-auto w-full">
          <thead class="border-b font-medium p-4 pl-8 pt-0 pb-3 text-slate-400 text-left bg-slate-200 rounded">
            <tr>
              <th class="border-b p-4 text-slate-700 text-left font-bold text-lg">Bloque</th>
              <th class="border-b p-4 text-slate-700 text-left font-bold text-lg">Pregunta</th>
              <th class="border-b p-4 text-slate-700 text-left font-bold text-lg">Qué pide</th>
              <th class="border-b p-4 text-slate-700 text-left font-bold text-lg">Tema</th>
            </tr>
          </thead>
          <tbody>
            {% for question in enhancedExamPage.questions %}
              <tr{% if loop.index is even %} class="bg-gray-50"{% endif %}>
                <td class="border-b border-slate-300 p-4 text-gray-600 font-bold">{{ question.block }}</td>
                <td class="border-b border-slate-300 p-4 text-body">{{ question.question }}</td>
                <td class="border-b border-slate-300 p-4 text-body">{{ question.task }}</td>
                <td class="border-b border-slate-300 p-4 text-body">{{ question.topic }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <h2 class="h2 mb-4">{{ enhancedExamPage.topicsTitle|default('Temas que aparecen') }}</h2>
      <ul class="list-disc list-inside text-lg mb-8">
        {% for topic in enhancedExamPage.topics %}
          <li>{{ topic }}</li>
        {% endfor %}
      </ul>

      <h2 class="h2 mb-4">{{ enhancedExamPage.practiceTitle|default('Cómo practicar este examen') }}</h2>
      <ol class="list-decimal list-inside text-lg mb-8">
        {% for step in enhancedExamPage.practiceSteps %}
          <li>{{ step }}</li>
        {% endfor %}
      </ol>

      <h2 class="h2 mb-4">{{ enhancedExamPage.relatedTitle|default('Exámenes relacionados') }}</h2>
      <div class="list-group">
        {% for relatedExam in enhancedExamPage.relatedExams %}
          {% if relatedExam.type == 'subject' %}
            {% set relatedExamHref = path('community_test_course_subject', {
              testSlug: communityTest.knowledgeTest.slug,
              communitySlug: communityTest.community.slug,
              courseSubjectSlug: courseSubject.subjectSlug
            }) %}
          {% else %}
            {% set relatedExamHref = path('exam', {
              testSlug: communityTest.knowledgeTest.slug,
              communitySlug: communityTest.community.slug,
              courseSubjectSlug: courseSubject.subjectSlug,
              examSlug: relatedExam.examSlug
            }) %}
          {% endif %}
          <a class="list-group-item" href="{{ relatedExamHref }}">
            <span>{{ relatedExam.label }}</span>
            <span class="list-group-item-badge"><i class="icon-angle-right"></i></span>
          </a>
        {% endfor %}
      </div>
    </article>

    <aside class="col-span-12 lg:col-span-4" role="complementary">
      <div class="simple-box mb-8 font-bold text-2xl">
        Dificultad: {{ exam.difficulty }}/10
      </div>
      <div class="simple-box mb-8">
        <h2 class="h4 mb-4">{{ enhancedExamPage.quickFactsTitle|default('Ficha rápida') }}</h2>
        <ul class="list-disc list-inside">
          {% for fact in enhancedExamPage.quickFacts %}
            <li>{{ fact }}</li>
          {% endfor %}
        </ul>
      </div>
      {% if showPauBundlePackPromo %}
        {% include 'common/products/pau_bundle_pack_promo.html.twig' with {
          pack: pauBundlePack,
          compact: true,
          event_label: enhancedExamPage.sidebarPackEventLabel|default(enhancedExamPage.analyticsLabel)
        } %}
      {% endif %}
      {% include 'ads/sidebar_ad.html.twig' with { 'mb': 'mb-8'} %}
      {% include 'common/elements/youtube_box.html.twig' %}
    </aside>
  </div>
</section>
