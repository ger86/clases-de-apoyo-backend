{% extends 'container_layout.html.twig' %}

{% set pauBundlePack = getPauBundlePackForProduct(product) %}

{% block metatags %}
{% set metaTitle = product.title ~ ' | Clases de Apoyo' %}
{% set metaDescription = pauBundlePack
  ? 'Descarga el pack completo de exámenes y soluciones de PAU/EvAU ' ~ pauBundlePack.subjectName ~ ' ' ~ pauBundlePack.communityName ~ ' ' ~ pauBundlePack.yearRange ~ '.'
  : product.title
%}
<title>{{ metaTitle }}</title>
<meta name="description" content="{{ metaDescription }}"/>
<meta property="og:title" content="{{ metaTitle }}" />
<meta property="og:description" content="{{ metaDescription }}" />
<link rel="canonical" href="{{ getCanonicalUrl() }}">
{% endblock %}

{% block pageTitle %}
{{ product.title }}
{% endblock %}

{% block pageContent %}
<section class="grid grid-cols-1 lg:grid-cols-12 gap-8">
  <div class="col-span-12 lg:col-span-8">
    <div class="text-lg mb-8">
      {{ product.description|raw }}
    </div>

    <div class="simple-box mb-8">
      <h2 class="h2 mb-4">Qué incluye</h2>
      <ul class="list-disc list-inside text-lg">
        {% if pauBundlePack %}
          <li>{{ pauBundlePack.statementCount }} documentos de enunciados de {{ pauBundlePack.subjectName }} de la PAU/EvAU de {{ pauBundlePack.communityName }}.</li>
          <li>{{ pauBundlePack.solutionCount }} documentos de soluciones.</li>
          <li>PDF completo de {{ pauBundlePack.completePages }} páginas con exámenes y soluciones.</li>
          <li>Archivos separados de enunciados y soluciones para estudiar con más comodidad.</li>
        {% else %}
          <li>Pack descargable con los archivos indicados más abajo.</li>
          <li>Pago único, sin suscripción.</li>
        {% endif %}
      </ul>
    </div>

    <div class="simple-box mb-8">
      <h2 class="h2 mb-4">Antes de comprar</h2>
      <p class="text-lg">
        {% if pauBundlePack %}
          Puedes probar gratis los enunciados más recientes en la web. Este pack está pensado para ahorrar tiempo cuando ya sabes que vas a practicar {{ pauBundlePack.subjectName }} {{ pauBundlePack.communityName }} en serio: todo el histórico descargable y organizado, con soluciones, en un solo lugar.
        {% else %}
          Este pack está pensado para ahorrar tiempo: material descargable y organizado en un solo lugar.
        {% endif %}
      </p>
    </div>

    <div class="simple-box mb-8">
      <h2 class="h2 mb-4">Pack o Premium</h2>
      <p class="text-lg mb-4">
        {% if pauBundlePack %}
          El pack es la mejor opción si solo quieres preparar {{ pauBundlePack.subjectName }} {{ pauBundlePack.communityName }} y conservar todos los exámenes y soluciones en PDF.
        {% else %}
          El pack es la mejor opción si solo quieres conservar este material en PDF.
        {% endif %}
      </p>
      <p class="text-lg">
        Si quieres acceder a toda la plataforma, usar el tutor IA y navegar sin anuncios, puedes hacerte Premium desde {{ subscriptionMonthlyPrice }} o {{ subscriptionYearlyPrice }}.
      </p>
    </div>

    <div class="simple-box">
      <h2 class="h2 mb-4">Archivos que recibirás</h2>
      <div class="list-group">
        {% for file in product.files %}
          <div class="list-group-item">
            <span>
              <strong>{{ file.label }}</strong>
              {% if file.description is defined %}
                <br><small>{{ file.description }}</small>
              {% endif %}
            </span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <aside class="col-span-12 lg:col-span-4" role="complementary">
    <div class="simple-box sticky">
      <p class="text-lg font-bold mb-2">Pago único</p>
      <p class="text-4xl font-bold mb-6">{{ product.formattedPrice }}</p>
      <form action="{{ path('product_checkout', {slug: product.slug}) }}" method="POST">
        <input type="hidden" name="_token" value="{{ csrf_token('product_checkout_' ~ product.id) }}">
        <button class="btn btn-secondary block w-full text-center" type="submit">
          Comprar y descargar
        </button>
      </form>
      <p class="mt-4 text-sm">
        Sin suscripción. El pago se realiza de forma segura con Stripe y, al completarlo, verás una página privada con tus descargas.
      </p>
    </div>
  </aside>
</section>
{% endblock %}
