{% set eventLabel = event_label|default('contextual') %}
{% set compact = compact|default(false) %}

<div class="simple-box mb-4 border border-green-200 bg-green-50">
  <p class="mb-2 text-sm font-bold uppercase text-green-700">Pack PAU {{ pack.communityName }}</p>
  <h3 class="{{ compact ? 'h4' : 'h3' }} mb-3">{{ pack.subjectName }} {{ pack.yearRange }}</h3>
  <p class="mb-4">
    Todos los enunciados y soluciones de {{ pack.subjectName }} de {{ pack.communityName }} en un único PDF descargable para practicar por años.
  </p>
  <p class="mb-4 text-sm font-bold text-green-800">Pago único, sin suscripción.</p>
  <a
    class="btn btn-secondary block text-center"
    href="{{ path('product_show', {slug: pack.slug}) }}"
    onclick="gtag('event', 'click', {
      'event_category': 'product-pack',
      'event_label': '{{ eventLabel }}'
    });"
  >
    Ver pack por {{ pack.formattedPrice }}
  </a>
</div>
