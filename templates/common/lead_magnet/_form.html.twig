{#
  Signup form of the free exam pack. Variables:
  - form_id: unique per page, for the input ids
  - pack_code (optional): code of the paid pack shown on this page, for the follow-up emails
  - email (optional): value to prefill
  - event_label: label of the analytics event
#}
{% set formId = form_id|default('lead-magnet') %}
<form
  method="post"
  action="{{ path('lead_magnet_subscribe') }}"
  onsubmit="if (typeof gtag === 'function') { gtag('event', 'generate_lead', {'event_category': 'lead-magnet', 'event_label': '{{ event_label|default('contextual')|e('js') }}'}); }"
>
  {% if pack_code|default(null) %}
  <input type="hidden" name="pack" value="{{ pack_code }}">
  {% endif %}
  {# Honeypot: hidden from people, filled in by bots. #}
  <div class="hidden" aria-hidden="true">
    <label for="{{ formId }}-website">No rellenes este campo</label>
    <input type="text" id="{{ formId }}-website" name="website" tabindex="-1" autocomplete="off">
  </div>
  <div class="form-group">
    <label for="{{ formId }}-email" class="label">Tu email</label>
    <input
      class="form-control"
      type="email"
      id="{{ formId }}-email"
      name="email"
      value="{{ email|default(app.user ? app.user.email : '') }}"
      maxlength="180"
      autocomplete="email"
      required
    >
  </div>
  <div class="form-group form-check mb-4">
    <input class="form-check-input" type="checkbox" id="{{ formId }}-consent" name="consent" value="1" required>
    <label class="form-check-label text-sm" for="{{ formId }}-consent">
      Quiero recibir los exámenes y, durante unos días, emails con consejos y ofertas de Clases de Apoyo. Puedo darme de baja cuando quiera.
      <a class="underline" href="{{ path('legal_notice_cookies') }}" target="_blank" rel="noopener">Política de privacidad</a>.
    </label>
  </div>
  <button type="submit" class="btn btn-secondary block w-full text-center">Enviarme los exámenes gratis</button>
</form>
