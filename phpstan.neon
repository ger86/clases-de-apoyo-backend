parameters:
    phpVersion: 80400
    level: 2
    paths:
        - src
    excludePaths:
        - %rootDir%/../../../migrations
    symfony:
        containerXmlPath: 'var/cache/dev/App_KernelDevDebugContainer.xml'
    doctrine:
        repositoryClass: Doctrine\Bundle\DoctrineBundle\Repository\ServiceEntityRepository
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - 
            message: '#Access to an undefined property Stripe\\StripeObject::\$object.#'
            path: %rootDir%/../../../src
        -
            message: '#Access to an undefined property Stripe\\StripeObject::\$end.#'
            path: %rootDir%/../../../src
        -
            identifier: missingType.iterableValue
        # Gedmo reads a null slug as "regenerate me from the source field", which is how the
        # admin's "leave blank to auto-generate" option works. The null never reaches the
        # database: SluggableListener fills it in on flush, and the NOT NULL column stays as the
        # guard that makes a dead listener fail loudly instead of silently.
        -
            identifier: doctrine.columnType
            message: '#^Property App\\Entity\\\w+::\$slug type mapping mismatch: property can contain string\|null but database expects string\.$#'
            path: %rootDir%/../../../src/Entity
